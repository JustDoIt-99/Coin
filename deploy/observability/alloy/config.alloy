discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "backend" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/coinco-backend"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }
}

loki.source.docker "backend" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.backend.output
  forward_to = [loki.process.backend.receiver]
}

loki.process "backend" {
  stage.static_labels {
    values = {
      service = "realtime-trading-backend",
      env     = "prod",
      job     = "backend",
    }
  }

  stage.json {
    expressions = {
      level      = "level",
      logger     = "logger_name",
      thread     = "thread_name",
      message    = "message",
      requestId  = "requestId",
      userId     = "userId",
      method     = "method",
      path       = "path",
      status     = "status",
      durationMs = "durationMs",
      exception  = "exception",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
